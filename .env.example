# Server
PORT=3000
NODE_ENV=production

# MongoDB Atlas
MONGO_URI=mongodb+srv://USER:PASS@cluster.example.mongodb.net/DB_NAME?retryWrites=true&w=majority

# JWT kaliti (kamida 48 ta tasodifiy belgi)
JWT_SECRET=

# Admin foydalanuvchi (npm run seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-8-chars
